#
# Engine-owned extraction of the platform options needed by Blink and shared
# resources. Based on content/public/common/features.gni at the pinned revision.
# These build options do not provide host services or create a renderer process.

import("//build/config/cast.gni")
import("//build/config/features.gni")

declare_args() {
  use_external_popup_menu = is_android || (is_apple && use_blink)
  enable_plugins = !is_android && !is_ios && !is_castos && !is_fuchsia
}

enable_screen_capture = is_linux || is_chromeos || (is_apple && use_blink) ||
                        is_win || is_android || is_fuchsia
